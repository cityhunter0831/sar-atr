    "# ── Cell 3: 파이프라인 동작 확인 (mock 데이터) ───────────────────────\n",
    "from core.mock_data import MockSARDataset\n",
    "from core.models import get_model\n",
    "from core.train import train_model\n",
    "from core.interfaces import TrainConfig\n",
    "\n",
    "for model_name in ['smpl', 'resnet18']:\n",
    "    model  = get_model(model_name, num_classes=5)\n",
    "    config = TrainConfig(model_name=model_name, num_classes=5, epochs=3, seed=0)\n",
    "    model, result = train_model(model,\n",
    "                                MockSARDataset(n=200, num_classes=5, seed=0),\n",
    "                                MockSARDataset(n=60,  num_classes=5, seed=1),\n",
    "                                config)\n",
    "    print(f'[{model_name}] mock val acc = {result.accuracy*100:.1f}%')\n",
    "\n",
    "print('\\n✅ 파이프라인 정상')"
   ]
  },
