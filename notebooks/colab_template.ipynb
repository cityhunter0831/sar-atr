   "source": [
    "# ── Cell 1: 우리 레포 clone + 패키지 설치 ────────────────────────────\n",
    "TOKEN = 'ghp_여기에_토큰_붙여넣기'   # ★ 본인 GitHub Personal Access Token\n",
    "\n",
    "import os, sys\n",
    "\n",
    "if not os.path.exists('/content/repo'):\n",
    "    !git clone https://{TOKEN}@github.com/cityhunter0831/sar-atr.git /content/repo\n",
    "else:\n",
    "    !cd /content/repo && git pull\n",
    "\n",
    "os.chdir('/content/repo')\n",
    "!pip install -r requirements.txt -q\n",
    "sys.path.insert(0, '/content/repo')\n",
    "\n",
    "import torch\n",
    "print('CUDA:', torch.cuda.is_available())\n",
    "if torch.cuda.is_available():\n",
    "    print('GPU:', torch.cuda.get_device_name(0))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2-drive",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 2: Drive 마운트 + 데이터 로컬 복사 ──────────────────────────\n",
    "# 런타임 재시작할 때마다 실행 필요 (/content는 재시작하면 초기화됨)\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "DRIVE_ROOT = '/content/drive/MyDrive/SAR_ATR_Project'\n",
    "\n",
    "import os\n",
    "os.makedirs(f'{DRIVE_ROOT}/data',    exist_ok=True)\n",
    "os.makedirs(f'{DRIVE_ROOT}/results', exist_ok=True)\n",
    "\n",
    "# gengzhe2015 데이터: Drive에 없으면 받아서 저장, 있으면 로컬로 복사\n",
    "GENG_DRIVE = f'{DRIVE_ROOT}/data/clutter_gengzhe'\n",
    "GENG_LOCAL = '/content/clutter_gengzhe'\n",
    "\n",
    "if not os.path.exists(GENG_DRIVE):\n",
    "    print('gengzhe2015 처음 다운로드 중...')\n",
    "    !git clone https://github.com/gengzhe2015/SAR-target-recognition.git /content/gengzhe2015\n",
    "    os.makedirs(GENG_DRIVE, exist_ok=True)\n",
    "    !cp -r /content/gengzhe2015/. {GENG_DRIVE}/\n",
    "    # zip 압축 풀기\n",
    "    for z in ['Original MSTAR Images', 'Train_OR_Test_CT', 'Train_CT_Test_CT', 'Train_CTx2_Test_CT']:\n",
    "        zpath = f'{GENG_DRIVE}/{z}.zip'\n",
    "        if os.path.exists(zpath):\n",
    "            !unzip -q \"{zpath}\" -d {GENG_DRIVE}/\n",
    "    print('Drive 저장 완료')\n",
    "\n",
    "if not os.path.exists(GENG_LOCAL):\n",
    "    print('Drive → 로컬 복사 중 (2~3분)...')\n",
    "    !cp -r {GENG_DRIVE} {GENG_LOCAL}\n",
    "    print('완료')\n",
    "else:\n",
    "    print('로컬 데이터 이미 존재')\n",
    "\n",
    "!ls {GENG_LOCAL}"
   ]
  },
